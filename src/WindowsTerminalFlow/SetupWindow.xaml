<Window x:Class="WindowsTerminalFlow.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowsTerminalFlow Setup" Width="520" Height="430" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="WindowsTerminalFlow 1.00" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <TextBlock Grid.Row="1" Text="Language / Jazyk"/>
        <ComboBox x:Name="LanguageBox" Grid.Row="1" Width="140" HorizontalAlignment="Right"><ComboBoxItem Content="Čeština" Tag="cs"/><ComboBoxItem Content="English" Tag="en"/></ComboBox>
        <TextBlock Grid.Row="2" Text="Logging" Margin="0,14,0,0"/>
        <ComboBox x:Name="LoggingBox" Grid.Row="2" Width="140" HorizontalAlignment="Right" Margin="0,10,0,0"><ComboBoxItem Content="off"/><ComboBoxItem Content="single"/><ComboBoxItem Content="all"/></ComboBox>
        <TextBlock Grid.Row="3" Text="Shell" Margin="0,14,0,0"/>
        <ComboBox x:Name="ShellBox" Grid.Row="3" Width="140" HorizontalAlignment="Right" Margin="0,10,0,0"><ComboBoxItem Content="cmd.exe"/><ComboBoxItem Content="powershell.exe"/><ComboBoxItem Content="pwsh.exe"/></ComboBox>
        <CheckBox x:Name="NewFoldersBox" Grid.Row="4" Content="Open newly discovered folders by default" Margin="0,18,0,0"/>
        <StackPanel Grid.Row="5" Margin="0,20,0,0"><TextBlock x:Name="AdminStatus" TextWrapping="Wrap"/><Button Content="Repair elevated launcher" Width="190" HorizontalAlignment="Left" Margin="0,8,0,0" Click="RepairLauncher_Click"/></StackPanel>
        <Button Grid.Row="6" Content="Save" Width="100" HorizontalAlignment="Right" Click="Save_Click"/>
    </Grid>
</Window>
