<Window x:Class="WindowsTerminalFlow.WorkspaceConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WTF Config" Width="560" Height="680" MinWidth="420" MinHeight="420">
    <DockPanel Margin="14">
        <TextBlock x:Name="RootText" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="90" Margin="4" Click="Save_Click"/>
            <Button Content="Cancel" Width="90" Margin="4" Click="Cancel_Click"/>
        </StackPanel>
        <ListBox x:Name="FolderList" AllowDrop="True" PreviewMouseLeftButtonDown="FolderList_MouseDown" Drop="FolderList_Drop">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding Enabled}" Content="{Binding Name}" Padding="4"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
